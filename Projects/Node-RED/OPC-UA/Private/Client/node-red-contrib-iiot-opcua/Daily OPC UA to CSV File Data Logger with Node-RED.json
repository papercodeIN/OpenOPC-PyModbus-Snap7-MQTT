    {
        "id": "4ab22ccd0d21ef43",
        "type": "function",
        "z": "8182b732.c2d69",
        "name": "function",
        "func": "// Input message contains the provided data\nvar input_data = msg.payload.value || [];\n\n// Check if input_data has the expected structure\nif (Array.isArray(input_data) && input_data.length >= 6) {\n  // Extract timestamp from the input_data array\n  var timestamp = new Date().toLocaleString();\n\n  // Function to handle non-numeric values\n  function toFixedNumber(value) {\n    return typeof value === 'number' ? value.toFixed(2) : '0.00';\n  }\n\n  // Extract values from the input_data array\n  var counter = toFixedNumber(input_data[0].value);\n  var random = toFixedNumber(input_data[1].value);\n  var sawtooth = toFixedNumber(input_data[2].value);\n  var sinusoid = toFixedNumber(input_data[3].value);\n  var square = toFixedNumber(input_data[4].value);\n  var triangle = toFixedNumber(input_data[5].value);\n\n  // Create the output array\n  var output_array = [\n    timestamp,\n    counter,\n    random,\n    sawtooth,\n    sinusoid,\n    square,\n    triangle,\n  ];\n\n  // Set the filename in the msg object with today's date and .csv extension\n  var today = new Date().toISOString().slice(0, 10); // Get today's date\n  msg.filename = \"C:/Users/Parrot/Desktop/\" + today + \".csv\";\n\n  // Update the output message payload\n  msg.payload = output_array;\n} else {\n  // Handle the case where input_data doesn't have the expected structure\n  msg.payload = 'Invalid input_data structure';\n  msg.filename = ''; // Optionally clear the filename if the data is invalid\n  \n}\n\n// Return the modified message\nreturn msg;\n",
