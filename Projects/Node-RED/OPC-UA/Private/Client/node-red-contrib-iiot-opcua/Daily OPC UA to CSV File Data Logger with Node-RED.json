    {
        "id": "6062a18dca2ac624",
        "type": "function",
        "z": "8182b732.c2d69",
        "name": "function 1",
        "func": "// Get the current date\nvar today = new Date().toISOString().slice(0, 10);\n\n// Get the last date from context\nvar lastDate = context.get('lastDate') || '';\n\n// Check if the date has changed\nvar dateChanged = lastDate !== today;\n\n// If the date has changed, send a reset signal along with the original payload and filename\nif (dateChanged) {\n  // Include msg.reset, the original payload, and filename\n  msg = {\n    reset: true,\n    originalPayload: msg.payload,\n    filename: msg.filename,\n  };\n} else {\n  // If the date has not changed, pass the original payload and filename without modification\n  msg = {\n    payload: msg.payload,\n    filename: msg.filename,\n  };\n}\n\n// Update lastDate in context to the current date\ncontext.set('lastDate', today);\n\n// Return the modified message\nreturn msg;\n",
