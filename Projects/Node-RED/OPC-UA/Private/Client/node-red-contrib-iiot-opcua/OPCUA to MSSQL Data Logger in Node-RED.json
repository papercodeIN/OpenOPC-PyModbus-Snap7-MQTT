    {
        "id": "679ffa73c82eecbc",
        "type": "function",
        "z": "7ffb1eea340734af",
        "g": "19fe61354e1f9607",
        "name": "Create INSERT Query",
        "func": "// Extract the results from the payload\nvar data = msg.payload.value.results;\n\n// Initialize an array to store multiple SQL queries\nvar queries = [];\n\n// Loop through the array of results\nfor (var i = 0; i < data.length; i++) {\n    // Check if the necessary fields (browseName and value) exist\n    if (data[i] && data[i].browseName && typeof data[i].value !== 'undefined') {\n        var tag = data[i].browseName.name; // Extract the 'name' (now 'Tag')\n        var tagValue = data[i].value; // Extract the 'value' (now 'TagValue')\n\n        // Construct the SQL query for insertion into OPCUA_Data table\n        var query = `INSERT INTO OPCUA_Data (Tag, TagValue) VALUES (N'${tag}', N'${tagValue}');`;\n\n        // Add the query to the array\n        queries.push(query);\n    } else {\n        // If data is invalid, log it for debugging\n        node.warn(`Invalid data at index ${i}: ${JSON.stringify(data[i])}`);\n    }\n}\n\n// If there are valid queries, join them and pass the final query\nif (queries.length > 0) {\n    msg.payload = queries.join(' '); // Combine queries into one string\n    return msg;\n} else {\n    // No valid data, do not pass anything to avoid MSSQL node crash\n    return null;\n}\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
