    {
        "id": "47a27d1a1c1b8460",
        "type": "function",
        "z": "6f6736f937cc9f44",
        "g": "d9ad7bcd06db64f0",
        "name": "Convert",
        "func": "// Parse the incoming JSON data\nvar data = msg.payload.value;\n\n// Initialize an empty array to hold the collected data\nvar collectedData = [];\n\n// Iterate through each data point\ndata.forEach(function(item) {\n    // Check if nodeId and name properties exist before accessing them\n    if (item.nodeId && item.nodeId.name) {\n        // Extract the variable name, nodeId, datatypeName, and value\n        var variableName = item.nodeId.name;\n        var variableValue = item.value;\n        var nodeId = item.nodeId.nodeId;\n        var datatypeName = item.nodeId.datatypeName;\n\n        // Add the data to the collectedData array\n        collectedData.push({\n            variableName: variableName,\n            value: variableValue,\n            nodeId: nodeId,\n            datatypeName: datatypeName\n        });\n    } else {\n        // Log a warning or handle the missing data as needed\n        console.warn(\"Skipping item: nodeId or name property is undefined.\");\n    }\n});\n\n// Send the MQTT message with all data points in JSON format\nnode.send({\n    topic: \"OPCUA\", // Set the MQTT topic to \"OPCUA\"\n    payload: collectedData // Set the payload as the collected data object\n});\n",
