        "type": "function",
        "z": "8182b732.c2d69",
        "name": "function",
        "func": "// Parse the incoming JSON data\nvar data = msg.payload.value;\n\n// Iterate through each data point\ndata.forEach(function(item) {\n    // Check if nodeId and name properties exist before accessing them\n    if (item.nodeId && item.nodeId.name) {\n        // Extract the variable name and value\n        var variableName = item.nodeId.name;\n        var variableValue = item.value;\n\n        // Send the MQTT message\n        node.send({\n            topic: variableName, // Set the MQTT topic as the variable name\n            payload: variableValue // Set the payload as the variable value\n        });\n    } else {\n        // Log a warning or handle the missing data as needed\n        console.warn(\"Skipping item: nodeId or name property is undefined.\");\n    }\n});\n",
