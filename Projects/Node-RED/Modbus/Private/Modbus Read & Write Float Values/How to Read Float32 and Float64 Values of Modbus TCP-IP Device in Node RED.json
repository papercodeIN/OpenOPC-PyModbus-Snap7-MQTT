        "id": "7122ccca71acbb52",
        "type": "function",
        "z": "a9f34d360d77dccf",
        "name": "Read | 32-bit Float | Little-Endian Byte Swap | LSRF |",
        "func": "msg.payload = [msg.payload[0],msg.payload[1]];\nlet pay = msg.payload;\n\nconst buf = Buffer.allocUnsafe(4);\nbuf.writeInt16BE(pay[0],2);\nbuf.writeInt16BE(pay[1],0);\n\nmsg.payload = buf.readFloatBE(0);\nreturn msg;",
