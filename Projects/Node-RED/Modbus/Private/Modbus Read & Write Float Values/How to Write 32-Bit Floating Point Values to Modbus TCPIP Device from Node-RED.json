    {
        "id": "a53a3eb4d89eaf7e",
        "type": "function",
        "z": "a9f34d360d77dccf",
        "name": "Write | 32-bit Float | Big-Endian | MSRF |",
        "func": "// Input value (replace this with your actual floating-point value)\nvar floatValue = msg.payload;\n\n// Create a Buffer to store the binary representation of the float\nvar buf = Buffer.allocUnsafe(4);\nbuf.writeFloatBE(floatValue, 0);\n\n// Extract two 16-bit integers from the Buffer in big-endian byte order\nvar holdingRegister1 = buf.readUInt16BE(0);\nvar holdingRegister2 = buf.readUInt16BE(2);\n\n// Output the two holding registers as an array\nconsole.log(\"Holding Register 1:\", holdingRegister1);\nconsole.log(\"Holding Register 2:\", holdingRegister2);\n\n// Output the two holding registers as an array\nmsg.payload = [holdingRegister1, holdingRegister2];\n\n// Send the modified message to the next node\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 520,
        "y": 380,
