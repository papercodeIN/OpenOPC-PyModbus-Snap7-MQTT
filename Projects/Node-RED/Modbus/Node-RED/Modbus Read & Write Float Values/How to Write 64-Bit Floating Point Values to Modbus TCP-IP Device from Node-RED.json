    {
        "id": "05faca5ce73ed7e1",
        "type": "function",
        "z": "a9f34d360d77dccf",
        "name": "Read | 64-bit Float | Double Float | Big-Endian | MSRF |",
        "func": "// Input values (replace these with your actual Modbus holding register values)\nvar holdingRegister1 = msg.payload[0];\nvar holdingRegister2 = msg.payload[1];\nvar holdingRegister3 = msg.payload[2];\nvar holdingRegister4 = msg.payload[3];\n\n// Combine 16-bit integers into a single 64-bit integer (big-endian byte order)\nvar combinedValue = BigInt(holdingRegister1) << 48n |\n                    BigInt(holdingRegister2) << 32n |\n                    BigInt(holdingRegister3) << 16n |\n                    BigInt(holdingRegister4);\n\n// Convert the combined value to a 64-bit float\nvar float64 = new Float64Array(new BigInt64Array([combinedValue]).buffer)[0];\n\n// Output the result\nmsg.payload = float64;\n\n// Send the modified message to the next node\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
