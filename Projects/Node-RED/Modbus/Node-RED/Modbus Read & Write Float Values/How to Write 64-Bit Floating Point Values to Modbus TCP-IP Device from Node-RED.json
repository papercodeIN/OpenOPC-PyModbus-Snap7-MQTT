    {
        "id": "a53a3eb4d89eaf7e",
        "type": "function",
        "z": "a9f34d360d77dccf",
        "name": "Write | 64-bit Float | Double Float | Little-Endian Byte Swap  | LSRF |",
        "func": "// Input value (replace this with your actual 64-bit float value)\nvar float64Input = msg.payload;\n\n// Create a Typed Array for the 64-bit float\nvar float64Array = new Float64Array(1);\nfloat64Array[0] = float64Input;\n\n// Extract the 64-bit integer as a BigInt from the Typed Array\nvar combinedValue = BigInt(new BigInt64Array(float64Array.buffer)[0]);\n\n// Extract individual 16-bit integers from the combined 64-bit integer\nvar holdingRegister4 = (combinedValue >> 48n) & 0xFFFFn;\nvar holdingRegister3 = (combinedValue >> 32n) & 0xFFFFn;\nvar holdingRegister2 = (combinedValue >> 16n) & 0xFFFFn;\nvar holdingRegister1 = combinedValue & 0xFFFFn;\n\n// Output the individual 16-bit integers\nmsg.payload = [Number(holdingRegister1), Number(holdingRegister2), Number(holdingRegister3), Number(holdingRegister4)];\n\n// Send the modified message to the next node\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
