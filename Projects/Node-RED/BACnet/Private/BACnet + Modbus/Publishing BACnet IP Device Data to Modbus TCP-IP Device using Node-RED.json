    {
        "id": "bc4d788fdfc7ccb9",
        "type": "function",
        "z": "d4fc4d97034cb730",
        "d": true,
        "name": "Write | 32-bit Float | Little-Endian Byte Swap | LSRF |",
        "func": "// Input value (replace this with your actual floating-point value)\nvar floatValue = msg.payload.values[0].value[0].value;\n\n// Round the float value to 2 decimal places\nvar roundedValue = parseFloat(floatValue.toFixed(2));\n\n// Create a Buffer to store the binary representation of the float\nvar buf = Buffer.allocUnsafe(4);\nbuf.writeFloatBE(roundedValue, 0);\n\n// Extract two 16-bit integers from the Buffer in big-endian byte order\nvar holdingRegister1 = buf.readUInt16BE(0);\nvar holdingRegister2 = buf.readUInt16BE(2);\n\n// Output the two holding registers as an array\nconsole.log(\"Holding Register 1:\", holdingRegister1);\nconsole.log(\"Holding Register 2:\", holdingRegister2);\n\n// Output the two holding registers as an array\nmsg.payload = [holdingRegister2, holdingRegister1];\n\n// Send the modified message to the next node\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
