    {
        "id": "3d5e0c1a71f80044",
        "type": "function",
        "z": "c2f97f831b10833d",
        "name": "function 6",
        "func": "// Assuming msg.payload contains the provided JSON data\n\n// Initialize an array to store the extracted data\nvar extractedData = [];\n\n// Check if msg.payload has the necessary structure\nif (msg.payload && msg.payload.hasOwnProperty(\"OBJECT_LIST(76)\")) {\n    // Iterate through the OBJECT_LIST(76) array\n    msg.payload[\"OBJECT_LIST(76)\"].forEach(function (obj) {\n        // Check if the object has OBJECT_NAME(77) and PRESENT_VALUE(85)\n        if (obj.hasOwnProperty(\"OBJECT_NAME(77)\") && obj.hasOwnProperty(\"PRESENT_VALUE(85)\")) {\n            // Extract OBJECT_NAME(77) and PRESENT_VALUE(85) and add to the array\n            var data = {\n                OBJECT_NAME: obj[\"OBJECT_NAME(77)\"],\n                PRESENT_VALUE: obj[\"PRESENT_VALUE(85)\"]\n            };\n            extractedData.push(data);\n        }\n    });\n}\n\n// Create separate messages for each extracted combination\nvar outputMessages = extractedData.map(function (data) {\n    // Clone the original message\n    var newMsg = RED.util.cloneMessage(msg);\n    // Set the extracted data as the payload of the new message\n    newMsg.payload = data;\n    return newMsg;\n});\n\nreturn outputMessages;\n",
        "outputs": 14,
        "timeout": 0,
        "noerr": 0,
