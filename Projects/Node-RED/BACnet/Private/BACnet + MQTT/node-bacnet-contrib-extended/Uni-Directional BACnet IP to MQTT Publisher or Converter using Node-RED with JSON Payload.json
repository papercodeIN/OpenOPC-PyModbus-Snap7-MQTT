    {
        "id": "05493092d756a262",
        "type": "function",
        "z": "47a3fa1776f331ee",
        "name": "Create JSON Payload + Topic",
        "func": "// Initialize an object to store the extracted data\nvar extractedData = {};\n\n// Check if msg.payload has the necessary structure\nif (msg.payload && msg.payload.hasOwnProperty(\"OBJECT_LIST(76)\")) {\n    // Iterate through the OBJECT_LIST(76) array\n    msg.payload[\"OBJECT_LIST(76)\"].forEach(function (obj) {\n        // Check if the object has OBJECT_NAME(77) and PRESENT_VALUE(85)\n        if (obj.hasOwnProperty(\"OBJECT_NAME(77)\") && obj.hasOwnProperty(\"PRESENT_VALUE(85)\")) {\n            // Extract OBJECT_NAME(77) and PRESENT_VALUE(85) and add to the object\n            var objectName = obj[\"OBJECT_NAME(77)\"];\n            var presentValue = obj[\"PRESENT_VALUE(85)\"];\n\n            // Construct the key in the desired format\n            var key = objectName.replace(/\\s/g, \"_\"); // Replace spaces with underscores if necessary\n\n            // Add to the extractedData object\n            extractedData[key] = presentValue;\n        }\n    });\n}\n\n// Create a JSON string from the object\nvar jsonString = JSON.stringify(extractedData);\n\n// Publish the JSON string to MQTT\nnode.send({\n    payload: jsonString,\n    topic: \"BACnet\"  // Replace with your MQTT topic\n});\n\n// Return nothing to avoid sending multiple messages to the debug sidebar\nreturn null;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
