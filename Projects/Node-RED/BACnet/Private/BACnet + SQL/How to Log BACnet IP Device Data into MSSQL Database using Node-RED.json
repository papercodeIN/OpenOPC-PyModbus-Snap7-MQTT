    {
        "id": "f41aa05062b8ca37",
        "type": "function",
        "z": "5c81feef98a4d9d1",
        "name": "Build INSERT Query",
        "func": "// Initialize an object to store the extracted data\nvar extractedData = {};\n\n// Check if msg.payload has the necessary structure\nif (msg.payload && msg.payload.hasOwnProperty(\"OBJECT_LIST(76)\")) {\n    msg.payload[\"OBJECT_LIST(76)\"].forEach(function (obj) {\n        if (obj.hasOwnProperty(\"OBJECT_NAME(77)\") && obj.hasOwnProperty(\"PRESENT_VALUE(85)\")) {\n            var objectName = obj[\"OBJECT_NAME(77)\"];\n            var presentValue = obj[\"PRESENT_VALUE(85)\"];\n            var key = objectName.replace(/\\s/g, \"_\"); // Replace spaces with underscores\n            extractedData[key] = presentValue;\n        }\n    });\n}\n\n// Get the current timestamp\nvar timestamp = new Date().toISOString(); // Converts to ISO string for MSSQL DATETIME format\n\n// Initialize an array to store SQL queries\nvar sqlQueries = [];\n\n// Function to escape single quotes\nfunction escapeSingleQuotes(str) {\n    return str.replace(/'/g, \"''\");\n}\n\n// Iterate over the extractedData object to build INSERT SQL queries\nfor (var key in extractedData) {\n    if (extractedData.hasOwnProperty(key)) {\n        var value = extractedData[key];\n        var sqlValue = typeof value === 'string' ? `'${escapeSingleQuotes(value)}'` : value; // Handle string escaping\n\n        var sqlQuery = `\n            INSERT INTO BACnet_Data (TimeStamp, Tag, TagValue) \n            VALUES ('${timestamp}', '${escapeSingleQuotes(key)}', ${sqlValue});\n        `;\n        sqlQueries.push(sqlQuery);\n    }\n}\n\n// Join all SQL queries into a single string\nvar sqlString = sqlQueries.join(\" \");\n\n// Log the SQL string for debugging\nconsole.log(\"Generated SQL Query:\", sqlString);\n\n// Set the SQL query as the payload\nmsg.payload = sqlString;\nmsg.topic = \"SQL/Insert\"; // Set your topic\n\nreturn msg;\n",
