# Example Mosquitto configuration for LOCAL DEVELOPMENT ONLY.
# No credentials and no TLS. Do not expose this to an untrusted network.
# Copy to your Mosquitto config directory and start: mosquitto -c mosquitto.conf

# Raw MQTT TCP listener (broker-side only — browsers do NOT use this port).
listener 1883 127.0.0.1
allow_anonymous true

# WebSocket listener used by this dashboard (MQTT over WebSockets).
listener 9001 127.0.0.1
protocol websockets
allow_anonymous true

# ---------------------------------------------------------------------------
# Production notes (configure on the broker, never commit real secrets):
#
#   listener 8883
#   protocol mqtt
#   cafile       /etc/mosquitto/certs/ca.crt
#   certfile     /etc/mosquitto/certs/server.crt
#   keyfile      /etc/mosquitto/certs/server.key
#   password_file /etc/mosquitto/passwd
#   acl_file     /etc/mosquitto/acl
#
#   listener 9002 0.0.0.0
#   protocol websockets
#   cafile       /etc/mosquitto/certs/ca.crt
#   certfile     /etc/mosquitto/certs/server.crt
#   keyfile      /etc/mosquitto/certs/server.key
#   password_file /etc/mosquitto/passwd
#   acl_file     /etc/mosquitto/acl
#
# Give this dashboard a read-only ACL for the configured topics, e.g.:
#   user dashboard-reader
#   topic read sensors/#
#
# In wss:// mode the browser validates the server certificate using the OS
# trust store. Self-signed/untrusted certificates will fail and cannot be
# bypassed from page JavaScript — install a trusted CA instead.
# ---------------------------------------------------------------------------
