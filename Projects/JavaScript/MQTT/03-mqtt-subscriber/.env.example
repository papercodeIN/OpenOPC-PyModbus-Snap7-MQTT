# Copy to .env and adjust. Never commit real credentials, certificates or keys.

# Local web service (the browser UI and the JSON API)
HTTP_HOST=127.0.0.1
HTTP_PORT=8082

# Binding to anything other than loopback exposes the UI and the live message stream.
ALLOW_REMOTE=false

# Broker connection: MQTT over TCP (no WebSocket listener required)
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_CLIENT_ID=
MQTT_USERNAME=
MQTT_PASSWORD=

# Comma-separated MQTT topic filters. Wildcards # and + are allowed.
MQTT_TOPICS=sensors/#
MQTT_QOS=0

# TLS: use mqtts (normally port 8883). Certificate validation is ON by default.
MQTT_USE_TLS=false
MQTT_CA_FILE=
MQTT_CERT_FILE=
MQTT_KEY_FILE=
MQTT_TLS_INSECURE=false

MQTT_KEEPALIVE=60
MQTT_CONNECT_TIMEOUT=15000
MQTT_RECONNECT_PERIOD=5000

# Payload handling in the inspector: json (parsed & pretty-printed) or raw
MQTT_PAYLOAD_MODE=json
MQTT_MAX_PAYLOAD_CHARS=512

MQTT_LOG_LEVEL=info
