# Copy to .env and adjust. Never put credentials in this file.

# Local web service
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=info

# Binding to anything other than loopback exposes the dashboard and its broker
# connection to the network. Opt in explicitly, only behind a firewall.
ALLOW_REMOTE=false

# Broker connection (same MQTT_* names as the publisher and subscriber)
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USE_TLS=false

# json or raw: how incoming payloads are handled in the page
MQTT_PAYLOAD_MODE=json

# Client timing
MQTT_KEEPALIVE=60
MQTT_CONNECT_TIMEOUT=15000
MQTT_RECONNECT_PERIOD=5000

# Dashboard-only: initial transport and optional WebSocket endpoint.
# ws:// or wss:// only; the browser cannot use the raw TCP port 1883.
DEFAULT_TRANSPORT=tcp
BROKER_WS_URL=ws://127.0.0.1:9001/mqtt

# Subscription defaults, pre-filled in the page
MQTT_TOPICS=sensors/#
MQTT_QOS=0

# Display limits and client id
MQTT_CLIENT_ID_PREFIX=mqtt-dash-
MAX_MESSAGES=200
MAX_HISTORY_POINTS=120
