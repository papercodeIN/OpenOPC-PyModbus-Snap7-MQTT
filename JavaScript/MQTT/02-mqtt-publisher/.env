# Copy to .env and adjust. Never commit real credentials, certificates or keys.

# Local web service (the browser UI and the JSON API)
HTTP_HOST=127.0.0.1
HTTP_PORT=8081

# Binding to anything other than loopback exposes the UI and publish API.
ALLOW_REMOTE=false

# Broker connection: MQTT over TCP (no WebSocket listener required)
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_CLIENT_ID=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_QOS=0
MQTT_RETAIN=false

# Payload handling: json (validated & serialized) or raw (sent as typed)
MQTT_PAYLOAD_MODE=json
MQTT_PAYLOAD={"temperature":24.5,"humidity":48}

MQTT_KEEPALIVE=60
MQTT_CONNECT_TIMEOUT=15000
MQTT_RECONNECT_PERIOD=5000

# A publish that is not acknowledged within this window fails instead of hanging.
MQTT_PUBLISH_TIMEOUT=10000

# TLS: use mqtts (normally port 8883). Certificate validation is ON by default.
MQTT_USE_TLS=false
MQTT_CA_FILE=
MQTT_CERT_FILE=
MQTT_KEY_FILE=
MQTT_TLS_INSECURE=false

# Defaults for the composer's burst mode (the UI can override them per run).
MQTT_INTERVAL_MS=2000
MQTT_MAX_MESSAGES=10

MQTT_LOG_LEVEL=info
